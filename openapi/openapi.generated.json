{
  "openapi": "3.1.0",
  "info": {
    "title": "AIGC Core Local Command Contract",
    "version": "0.1.0",
    "description": "Documentation contract for local Tauri IPC invocations, not HTTP endpoints. Governance kernel plus EvidenceOS."
  },
  "paths": {
    "/commands/get_network_snapshot": {
      "post": {
        "summary": "Get network posture declaration",
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UiNetworkSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/commands/list_control_library": {
      "post": {
        "summary": "List EvidenceOS controls",
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ControlDefinition"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "enabledCapabilities": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commands/generate_evidenceos_bundle": {
      "post": {
        "summary": "Generate an EvidenceOS bundle",
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceOsRunResult"
                }
              }
            }
          },
          "default": {
            "description": "Rejected local IPC invocation (not an HTTP status).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "$ref": "#/components/schemas/EvidenceOsRunInput"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commands/authority_integrity_probe_adapter": {
      "post": {
        "summary": "Probe the loopback policy through Tauri IPC",
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityIntegrityProbeResult"
                }
              }
            }
          },
          "default": {
            "description": "Rejected local IPC invocation (not an HTTP status).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "$ref": "#/components/schemas/AuthorityIntegrityProbeInput"
                  }
                }
              }
            }
          }
        },
        "x-cargo-feature": "authority-integrity-test-hooks",
        "description": "Test-only; absent from production command registration."
      }
    }
  },
  "components": {
    "schemas": {
      "UiNetworkSnapshot": {
        "type": "object",
        "required": [
          "network_mode",
          "proof_level",
          "ui_remote_fetch_disabled"
        ],
        "properties": {
          "network_mode": {
            "type": "string",
            "enum": [
              "OFFLINE"
            ]
          },
          "proof_level": {
            "type": "string",
            "enum": [
              "OFFLINE_STRICT"
            ]
          },
          "ui_remote_fetch_disabled": {
            "type": "boolean",
            "const": true
          }
        },
        "example": {
          "network_mode": "OFFLINE",
          "proof_level": "OFFLINE_STRICT",
          "ui_remote_fetch_disabled": true
        }
      },
      "ControlDefinition": {
        "type": "object",
        "required": [
          "control_id",
          "title",
          "capability",
          "control_family",
          "description"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "control_family": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "EvidenceOsRunInput": {
        "type": "object",
        "required": [
          "enabled_capabilities",
          "artifact_title",
          "artifact_body",
          "artifact_tags_csv",
          "control_families_csv",
          "claim_text"
        ],
        "properties": {
          "enabled_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact_title": {
            "type": "string"
          },
          "artifact_body": {
            "type": "string"
          },
          "artifact_tags_csv": {
            "type": "string"
          },
          "control_families_csv": {
            "type": "string"
          },
          "claim_text": {
            "type": "string"
          }
        },
        "example": {
          "enabled_capabilities": [
            "Traceability"
          ],
          "artifact_title": "Controlled evidence",
          "artifact_body": "Bounded local evidence",
          "artifact_tags_csv": "OPS,NETWORK",
          "control_families_csv": "Traceability",
          "claim_text": "The controlled bundle path was exercised."
        }
      },
      "EvidenceAuthorityManifest": {
        "type": "object",
        "required": [
          "schema_version",
          "case_id",
          "requested_execution_class",
          "observed_execution_class",
          "evidence_origin",
          "generated_at_utc",
          "valid_until_utc",
          "credential_availability",
          "production_equivalent",
          "source",
          "allowed_effects",
          "observed_effects",
          "tools",
          "state_scope",
          "downstream_claims",
          "limitations"
        ],
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "case_id": {
            "type": "string"
          },
          "requested_execution_class": {
            "type": "string"
          },
          "observed_execution_class": {
            "type": "string"
          },
          "evidence_origin": {
            "type": "string"
          },
          "generated_at_utc": {
            "type": "string"
          },
          "valid_until_utc": {
            "type": "string"
          },
          "credential_availability": {
            "type": "string"
          },
          "production_equivalent": {
            "type": "boolean"
          },
          "source": {
            "type": "object",
            "required": [
              "producer",
              "source_revision",
              "executable",
              "executable_sha256",
              "arguments_sha256",
              "environment_sha256",
              "audit_log_sha256"
            ],
            "properties": {
              "producer": {
                "type": "string"
              },
              "source_revision": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "executable_sha256": {
                "type": "string"
              },
              "arguments_sha256": {
                "type": "string"
              },
              "environment_sha256": {
                "type": "string"
              },
              "audit_log_sha256": {
                "type": "string"
              }
            }
          },
          "allowed_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tool_id",
                "declared_available",
                "observed_used",
                "external_mutation_allowed"
              ],
              "properties": {
                "tool_id": {
                  "type": "string"
                },
                "declared_available": {
                  "type": "boolean"
                },
                "observed_used": {
                  "type": "boolean"
                },
                "external_mutation_allowed": {
                  "type": "boolean"
                }
              }
            }
          },
          "state_scope": {
            "type": "object",
            "required": [
              "cache_scope",
              "prior_approval_reused",
              "credential_state_reused",
              "mutable_cache_reused"
            ],
            "properties": {
              "cache_scope": {
                "type": "string"
              },
              "prior_approval_reused": {
                "type": "boolean"
              },
              "credential_state_reused": {
                "type": "boolean"
              },
              "mutable_cache_reused": {
                "type": "boolean"
              }
            }
          },
          "downstream_claims": {
            "type": "object",
            "required": [
              "may_satisfy",
              "must_not_satisfy"
            ],
            "properties": {
              "may_satisfy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_satisfy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EvidenceOsRunResult": {
        "type": "object",
        "required": [
          "status",
          "bundle_path",
          "bundle_sha256",
          "missing_control_ids",
          "evidence_authority"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED"
            ]
          },
          "bundle_path": {
            "type": "string"
          },
          "bundle_sha256": {
            "type": "string"
          },
          "missing_control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_authority": {
            "$ref": "#/components/schemas/EvidenceAuthorityManifest"
          }
        },
        "example": {
          "status": "COMPLETED",
          "bundle_path": "/runtime/evidence_bundle_evidenceos_v1.zip",
          "bundle_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "missing_control_ids": [],
          "evidence_authority": {
            "schema_version": "EVIDENCE_AUTHORITY_V1",
            "case_id": "r_example",
            "requested_execution_class": "CONTROLLED",
            "observed_execution_class": "CONTROLLED",
            "evidence_origin": "CONTROL_SIMULATION",
            "production_equivalent": false,
            "generated_at_utc": "2026-10-12T12:00:00Z",
            "valid_until_utc": "2026-10-13T12:00:00Z",
            "source": {
              "producer": "aigccore-tauri:generate_evidenceos_bundle",
              "source_revision": "example-revision",
              "executable": "/runtime/aigccore",
              "executable_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "arguments_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "environment_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
              "audit_log_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
            },
            "allowed_effects": [
              "LOCAL_RUNTIME_DIRECTORY_WRITE",
              "LOCAL_AUDIT_LOG_WRITE",
              "LOCAL_EVIDENCE_BUNDLE_WRITE"
            ],
            "observed_effects": [
              "LOCAL_RUNTIME_DIRECTORY_WRITE",
              "LOCAL_AUDIT_LOG_WRITE",
              "LOCAL_EVIDENCE_BUNDLE_WRITE"
            ],
            "credential_availability": "NOT_REQUESTED",
            "tools": [
              {
                "tool_id": "LOCAL_EVIDENCE_BUNDLE_EXPORT",
                "declared_available": true,
                "observed_used": true,
                "external_mutation_allowed": false
              },
              {
                "tool_id": "MODEL_INFERENCE",
                "declared_available": false,
                "observed_used": false,
                "external_mutation_allowed": false
              },
              {
                "tool_id": "EXTERNAL_PUBLICATION_OR_DEPLOYMENT",
                "declared_available": false,
                "observed_used": false,
                "external_mutation_allowed": false
              }
            ],
            "state_scope": {
              "cache_scope": "CASE_LOCAL",
              "prior_approval_reused": false,
              "credential_state_reused": false,
              "mutable_cache_reused": false
            },
            "downstream_claims": {
              "may_satisfy": [
                "LOCAL_CONTROLLED_EXECUTION",
                "BUNDLE_INTEGRITY",
                "OFFLINE_POLICY_CONFIGURATION"
              ],
              "must_not_satisfy": [
                "LIVE_EXECUTION",
                "PRODUCTION_AUTHORITY",
                "EXTERNAL_MUTATION",
                "REAL_USER_SUCCESS",
                "CURRENT_RUNTIME_CAPABILITY",
                "DEPLOYABILITY",
                "LIVE_EVALUATION_COMPLETION",
                "LIVE_EGRESS_BLOCKED"
              ]
            },
            "limitations": [
              "Blocked-egress evidence is a control simulation, not an observed network request.",
              "No production credentials, external mutation authority, deployment, publication, or real-user outcome was exercised.",
              "This receipt may not authorize live or production claims."
            ]
          }
        }
      },
      "AuthorityIntegrityProbeInput": {
        "type": "object",
        "required": [
          "endpoint"
        ],
        "properties": {
          "endpoint": {
            "type": "string"
          }
        },
        "example": {
          "endpoint": "http://127.0.0.1:49152"
        }
      },
      "AuthorityIntegrityProbeResult": {
        "type": "object",
        "required": [
          "adapter_id",
          "endpoint",
          "dependency_path_reached"
        ],
        "properties": {
          "adapter_id": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "dependency_path_reached": {
            "type": "boolean"
          }
        },
        "example": {
          "adapter_id": "authority-integrity-probe",
          "endpoint": "http://127.0.0.1:49152",
          "dependency_path_reached": true
        }
      }
    }
  }
}
