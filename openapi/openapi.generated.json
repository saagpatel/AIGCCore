{
  "openapi": "3.1.0",
  "info": {
    "title": "AIGC Core Local Command Contract",
    "version": "0.1.0",
    "description": "Documentation contract for local Tauri IPC invocations, not HTTP endpoints. Governance kernel plus EvidenceOS."
  },
  "paths": {
    "/commands/get_network_snapshot": {
      "post": {
        "summary": "Get network posture declaration",
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UiNetworkSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/commands/list_control_library": {
      "post": {
        "summary": "List EvidenceOS controls",
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ControlDefinition"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "enabledCapabilities": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commands/generate_evidenceos_bundle": {
      "post": {
        "summary": "Generate an EvidenceOS bundle",
        "x-exported-bundle-contract": {
          "bundle_version": "1.1.0",
          "truthful_snapshot_schemas": {
            "policy_snapshot": "#/components/schemas/TruthfulPolicySnapshot",
            "network_snapshot": "#/components/schemas/TruthfulNetworkSnapshot",
            "model_snapshot": "#/components/schemas/TruthfulModelSnapshot"
          },
          "declared_sha256_pattern": "^[0-9a-f]{64}$",
          "legacy_behavior": "Bundles with an older bundle_version remain inspectable and report LEGACY_UNVERIFIABLE; they do not pass as truthful."
        },
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceOsRunResult"
                }
              }
            }
          },
          "default": {
            "description": "Rejected local IPC invocation (not an HTTP status).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "$ref": "#/components/schemas/EvidenceOsRunInput"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commands/authority_integrity_probe_adapter": {
      "post": {
        "summary": "Probe the loopback policy through Tauri IPC",
        "responses": {
          "200": {
            "description": "Successful local IPC result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityIntegrityProbeResult"
                }
              }
            }
          },
          "default": {
            "description": "Rejected local IPC invocation (not an HTTP status).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "$ref": "#/components/schemas/AuthorityIntegrityProbeInput"
                  }
                }
              }
            }
          }
        },
        "x-cargo-feature": "authority-integrity-test-hooks",
        "description": "Test-only; absent from production command registration."
      }
    }
  },
  "components": {
    "schemas": {
      "UiNetworkSnapshot": {
        "type": "object",
        "required": [
          "network_mode",
          "proof_level",
          "proof_source",
          "adapter_endpoints",
          "ui_remote_fetch_disabled"
        ],
        "properties": {
          "network_mode": {
            "type": "string",
            "enum": [
              "OFFLINE"
            ]
          },
          "proof_level": {
            "type": "string",
            "enum": [
              "OFFLINE_STRICT"
            ]
          },
          "proof_source": {
            "type": "string",
            "enum": [
              "POLICY_DECLARATION",
              "MEASURED"
            ],
            "description": "POLICY_DECLARATION means the posture comes from enforced policy and is not a network measurement."
          },
          "adapter_endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Endpoints used by an adapter in the relevant run; empty when no adapter ran."
          },
          "ui_remote_fetch_disabled": {
            "type": "boolean",
            "const": true
          }
        },
        "example": {
          "network_mode": "OFFLINE",
          "proof_level": "OFFLINE_STRICT",
          "proof_source": "POLICY_DECLARATION",
          "adapter_endpoints": [],
          "ui_remote_fetch_disabled": true
        }
      },
      "ControlDefinition": {
        "type": "object",
        "required": [
          "control_id",
          "title",
          "capability",
          "control_family",
          "description"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "control_family": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "EvidenceOsRunInput": {
        "type": "object",
        "required": [
          "enabled_capabilities",
          "artifact_title",
          "artifact_body",
          "artifact_tags_csv",
          "control_families_csv",
          "claim_text"
        ],
        "properties": {
          "enabled_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact_title": {
            "type": "string"
          },
          "artifact_body": {
            "type": "string"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Optional SHA-256 of the exact UTF-8 bytes of artifact_body, including empty content. If omitted, the backend computes it from those exact bytes. A malformed or mismatching declared digest is rejected."
          },
          "artifact_tags_csv": {
            "type": "string"
          },
          "control_families_csv": {
            "type": "string"
          },
          "claim_text": {
            "type": "string"
          }
        },
        "example": {
          "enabled_capabilities": [
            "Traceability"
          ],
          "artifact_title": "Controlled evidence",
          "artifact_body": "Bounded local evidence",
          "artifact_sha256": "a73e5152bf4d84940a7f0e552bbf99478b5e6882c74f89ac804cd3e4af0ad1e2",
          "artifact_tags_csv": "OPS,NETWORK",
          "control_families_csv": "Traceability",
          "claim_text": "The controlled bundle path was exercised."
        }
      },
      "TruthfulPolicySnapshot": {
        "type": "object",
        "required": [
          "encryption_at_rest"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "encryption_at_rest": {
                  "const": true
                }
              },
              "required": [
                "encryption_at_rest"
              ]
            },
            "then": {
              "required": [
                "encryption_algorithm"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "encryption_algorithm"
                ]
              }
            }
          }
        ],
        "properties": {
          "encryption_at_rest": {
            "type": "boolean"
          },
          "encryption_algorithm": {
            "type": "string",
            "enum": [
              "AES_256_GCM",
              "XCHACHA20_POLY1305"
            ],
            "description": "Omitted when encryption_at_rest is false."
          }
        },
        "description": "A true encryption claim requires actual vault use and a matching VAULT_ENCRYPTION_STATUS audit event with an accepted key_storage value."
      },
      "TruthfulNetworkSnapshot": {
        "type": "object",
        "required": [
          "proof_level",
          "proof_source",
          "adapter_endpoints"
        ],
        "properties": {
          "proof_level": {
            "type": "string"
          },
          "proof_source": {
            "type": "string",
            "enum": [
              "POLICY_DECLARATION",
              "MEASURED"
            ]
          },
          "adapter_endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "POLICY_DECLARATION records enforced policy, not measured traffic. The endpoint list is empty when no adapter ran."
      },
      "TruthfulModelSnapshot": {
        "type": [
          "object",
          "null"
        ],
        "description": "JSON null when no model ran. If present, its adapter_endpoint must occur in network_snapshot.adapter_endpoints and run_manifest.model_calls must be nonempty.",
        "properties": {
          "adapter_id": {
            "type": "string"
          },
          "adapter_version": {
            "type": "string"
          },
          "adapter_endpoint": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pinning_level": {
            "type": "string",
            "enum": [
              "CRYPTO_PINNED",
              "VERSION_PINNED",
              "NAME_ONLY"
            ]
          }
        }
      },
      "EvidenceBundleInfo": {
        "type": "object",
        "required": [
          "bundle_version",
          "core_build",
          "run_id"
        ],
        "properties": {
          "bundle_version": {
            "type": "string",
            "const": "1.1.0"
          },
          "core_build": {
            "type": "string",
            "description": "Package version and compiled source revision; not a placeholder."
          },
          "run_id": {
            "type": "string"
          }
        },
        "description": "Truthful snapshot contract metadata for the generated archive."
      },
      "EvidenceAuthorityManifest": {
        "type": "object",
        "required": [
          "schema_version",
          "case_id",
          "requested_execution_class",
          "observed_execution_class",
          "evidence_origin",
          "generated_at_utc",
          "valid_until_utc",
          "credential_availability",
          "production_equivalent",
          "source",
          "allowed_effects",
          "observed_effects",
          "tools",
          "state_scope",
          "downstream_claims",
          "limitations"
        ],
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "case_id": {
            "type": "string"
          },
          "requested_execution_class": {
            "type": "string"
          },
          "observed_execution_class": {
            "type": "string"
          },
          "evidence_origin": {
            "type": "string",
            "enum": [
              "LOCAL_ARTIFACT_EXPORT",
              "CONTROL_SIMULATION",
              "RUNTIME_OBSERVATION",
              "FIXTURE",
              "REPLAY"
            ],
            "description": "LOCAL_ARTIFACT_EXPORT identifies a local bundle-writing run without simulated egress. CONTROL_SIMULATION is reserved for actual control-simulation runs and their blocked-egress evidence contract."
          },
          "generated_at_utc": {
            "type": "string"
          },
          "valid_until_utc": {
            "type": "string"
          },
          "credential_availability": {
            "type": "string"
          },
          "production_equivalent": {
            "type": "boolean"
          },
          "source": {
            "type": "object",
            "required": [
              "producer",
              "source_revision",
              "executable",
              "executable_sha256",
              "arguments_sha256",
              "environment_sha256",
              "audit_log_sha256"
            ],
            "properties": {
              "producer": {
                "type": "string"
              },
              "source_revision": {
                "type": "string"
              },
              "executable": {
                "type": "string"
              },
              "executable_sha256": {
                "type": "string"
              },
              "arguments_sha256": {
                "type": "string"
              },
              "environment_sha256": {
                "type": "string"
              },
              "audit_log_sha256": {
                "type": "string"
              }
            }
          },
          "allowed_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observed_effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tool_id",
                "declared_available",
                "observed_used",
                "external_mutation_allowed"
              ],
              "properties": {
                "tool_id": {
                  "type": "string"
                },
                "declared_available": {
                  "type": "boolean"
                },
                "observed_used": {
                  "type": "boolean"
                },
                "external_mutation_allowed": {
                  "type": "boolean"
                }
              }
            }
          },
          "state_scope": {
            "type": "object",
            "required": [
              "cache_scope",
              "prior_approval_reused",
              "credential_state_reused",
              "mutable_cache_reused"
            ],
            "properties": {
              "cache_scope": {
                "type": "string"
              },
              "prior_approval_reused": {
                "type": "boolean"
              },
              "credential_state_reused": {
                "type": "boolean"
              },
              "mutable_cache_reused": {
                "type": "boolean"
              }
            }
          },
          "downstream_claims": {
            "type": "object",
            "required": [
              "may_satisfy",
              "must_not_satisfy"
            ],
            "properties": {
              "may_satisfy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_satisfy": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EvidenceOsRunResult": {
        "type": "object",
        "required": [
          "status",
          "bundle_path",
          "bundle_sha256",
          "missing_control_ids",
          "evidence_authority",
          "encryption_at_rest",
          "model_used"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPLETED"
            ]
          },
          "bundle_path": {
            "type": "string"
          },
          "bundle_sha256": {
            "type": "string"
          },
          "missing_control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_authority": {
            "$ref": "#/components/schemas/EvidenceAuthorityManifest"
          },
          "encryption_at_rest": {
            "type": "boolean",
            "description": "Whether this exported run actually used at-rest encryption."
          },
          "model_used": {
            "type": "boolean",
            "description": "Whether model inference ran in this exported run."
          }
        },
        "example": {
          "status": "COMPLETED",
          "bundle_path": "/runtime/evidence_bundle_evidenceos_v1.zip",
          "bundle_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
          "missing_control_ids": [],
          "encryption_at_rest": false,
          "model_used": false,
          "evidence_authority": {
            "schema_version": "EVIDENCE_AUTHORITY_V1",
            "case_id": "r_example",
            "requested_execution_class": "CONTROLLED",
            "observed_execution_class": "CONTROLLED",
            "evidence_origin": "LOCAL_ARTIFACT_EXPORT",
            "production_equivalent": false,
            "generated_at_utc": "2026-10-12T12:00:00Z",
            "valid_until_utc": "2026-10-13T12:00:00Z",
            "source": {
              "producer": "aigccore-tauri:generate_evidenceos_bundle",
              "source_revision": "example-revision",
              "executable": "/runtime/aigccore",
              "executable_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "arguments_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "environment_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
              "audit_log_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
            },
            "allowed_effects": [
              "LOCAL_RUNTIME_DIRECTORY_WRITE",
              "LOCAL_AUDIT_LOG_WRITE",
              "LOCAL_EVIDENCE_BUNDLE_WRITE"
            ],
            "observed_effects": [
              "LOCAL_RUNTIME_DIRECTORY_WRITE",
              "LOCAL_AUDIT_LOG_WRITE",
              "LOCAL_EVIDENCE_BUNDLE_WRITE"
            ],
            "credential_availability": "NOT_REQUESTED",
            "tools": [
              {
                "tool_id": "LOCAL_EVIDENCE_BUNDLE_EXPORT",
                "declared_available": true,
                "observed_used": true,
                "external_mutation_allowed": false
              },
              {
                "tool_id": "MODEL_INFERENCE",
                "declared_available": false,
                "observed_used": false,
                "external_mutation_allowed": false
              },
              {
                "tool_id": "EXTERNAL_PUBLICATION_OR_DEPLOYMENT",
                "declared_available": false,
                "observed_used": false,
                "external_mutation_allowed": false
              }
            ],
            "state_scope": {
              "cache_scope": "CASE_LOCAL",
              "prior_approval_reused": false,
              "credential_state_reused": false,
              "mutable_cache_reused": false
            },
            "downstream_claims": {
              "may_satisfy": [
                "LOCAL_CONTROLLED_EXECUTION",
                "BUNDLE_INTEGRITY",
                "OFFLINE_POLICY_CONFIGURATION"
              ],
              "must_not_satisfy": [
                "LIVE_EXECUTION",
                "PRODUCTION_AUTHORITY",
                "EXTERNAL_MUTATION",
                "REAL_USER_SUCCESS",
                "CURRENT_RUNTIME_CAPABILITY",
                "DEPLOYABILITY",
                "LIVE_EVALUATION_COMPLETION",
                "LIVE_EGRESS_BLOCKED"
              ]
            },
            "limitations": [
              "Network posture is a policy declaration; no network measurement or blocked request was recorded.",
              "No production credentials, external mutation authority, deployment, publication, or real-user outcome was exercised.",
              "This receipt may not authorize live or production claims."
            ]
          }
        }
      },
      "AuthorityIntegrityProbeInput": {
        "type": "object",
        "required": [
          "endpoint"
        ],
        "properties": {
          "endpoint": {
            "type": "string"
          }
        },
        "example": {
          "endpoint": "http://127.0.0.1:49152"
        }
      },
      "AuthorityIntegrityProbeResult": {
        "type": "object",
        "required": [
          "adapter_id",
          "endpoint",
          "dependency_path_reached"
        ],
        "properties": {
          "adapter_id": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "dependency_path_reached": {
            "type": "boolean"
          }
        },
        "example": {
          "adapter_id": "authority-integrity-probe",
          "endpoint": "http://127.0.0.1:49152",
          "dependency_path_reached": true
        }
      }
    }
  }
}
